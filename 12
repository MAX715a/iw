-- ============================================================
-- 👑 MAX LUXURY ENGINE | Device-Adaptive Universal UI
-- 🌐 GitHub Executable Loadstring
-- ============================================================

local MAX_UI = {}
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local Stats = game:GetService("Stats")

local LocalPlayer = Players.LocalPlayer

-- 📱 1. التعرف التلقائي على نوع الجهاز (Mobile / PC)
local IsMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local DeviceType = IsMobile and "Mobile 📱" or "PC 🖥️"

-- 🔓 فك قفل الفريمات
pcall(function()
    if setfpscap then setfpscap(240)
    elseif set_fps_cap then set_fps_cap(240) end
end)

-- ألوان الواجهة الافتراضية
local Theme = {
    Background = Color3.fromRGB(12, 12, 16),
    Sidebar = Color3.fromRGB(8, 8, 12),
    Accent = Color3.fromRGB(0, 170, 255), -- اللون الافتراضي (أزرق نيون)
    Text = Color3.fromRGB(245, 245, 250),
    DarkText = Color3.fromRGB(140, 140, 150),
    ItemBg = Color3.fromRGB(20, 20, 28)
}

function MAX_UI:CreateWindow(Options)
    Options = Options or {}
    local TitleText = Options.Name or "MAX HUB | LUXURY"
    local LogoId = Options.Logo or "rbxassetid://6031075931"

    local ParentGui = (gethui and gethui()) or CoreGui or LocalPlayer:WaitForChild("PlayerGui")
    if ParentGui:FindFirstChild("MAX_LuxuryUI") then
        ParentGui.MAX_LuxuryUI:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "MAX_LuxuryUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = ParentGui

    -- 📐 تحديد مقاس الشاشة تلقائياً حسب الجهاز
    local DefaultSize = IsMobile and UDim2.new(0, 460, 0, 270) or UDim2.new(0, 580, 0, 360)
    local DefaultPos = IsMobile and UDim2.new(0.5, -230, 0.5, -135) or UDim2.new(0.5, -290, 0.5, -180)

    -- النافذة الرئيسية
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = DefaultSize
    MainFrame.Position = DefaultPos
    MainFrame.BackgroundColor3 = Theme.Background
    MainFrame.BorderSizePixel = 0
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = ScreenGui

    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 12)
    MainCorner.Parent = MainFrame

    local MainStroke = Instance.new("UIStroke")
    MainStroke.Color = Theme.Accent
    MainStroke.Thickness = 1.5
    MainStroke.Parent = MainFrame

    -- 📊 شريط FPS / Ping / Device العلوي
    local Topbar = Instance.new("Frame")
    Topbar.Size = UDim2.new(1, -12, 0, 26)
    Topbar.Position = UDim2.new(0, 6, 0, 6)
    Topbar.BackgroundColor3 = Theme.Sidebar
    Topbar.Parent = MainFrame

    local TopbarCorner = Instance.new("UICorner")
    TopbarCorner.CornerRadius = UDim.new(0, 8)
    TopbarCorner.Parent = Topbar

    local StatsLabel = Instance.new("TextLabel")
    StatsLabel.Size = UDim2.new(1, -12, 1, 0)
    StatsLabel.Position = UDim2.new(0, 6, 0, 0)
    StatsLabel.BackgroundTransparency = 1
    StatsLabel.TextColor3 = Theme.Text
    StatsLabel.Font = Enum.Font.GothamBold
    StatsLabel.TextSize = IsMobile and 10 or 11
    StatsLabel.TextXAlignment = Enum.TextXAlignment.Left
    StatsLabel.Text = "⚡ FPS: ... | 📡 Ping: ... | الجهاز: " .. DeviceType
    StatsLabel.Parent = Topbar

    -- حساب الفريمات والبينج اللحظي
    local frameCount = 0
    local lastTime = tick()

    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local currentTime = tick()
        if currentTime - lastTime >= 0.25 then
            local realFPS = math.floor(frameCount / (currentTime - lastTime))
            local pingVal = 0
            pcall(function()
                pingVal = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
            StatsLabel.Text = string.format("⚡ FPS: %d  |  📡 Ping: %dms  |  الجهاز: %s", realFPS, pingVal, DeviceType)
            frameCount = 0
            lastTime = currentTime
        end
    end)

    -- الشريط الجانبي (Sidebar)
    local Sidebar = Instance.new("Frame")
    Sidebar.Name = "Sidebar"
    Sidebar.Size = UDim2.new(0, IsMobile and 130 or 160, 1, -38)
    Sidebar.Position = UDim2.new(0, 6, 0, 36)
    Sidebar.BackgroundColor3 = Theme.Sidebar
    Sidebar.Parent = MainFrame

    local SidebarCorner = Instance.new("UICorner")
    SidebarCorner.CornerRadius = UDim.new(0, 10)
    SidebarCorner.Parent = Sidebar

    -- اللوجو والعنوان
    local LogoImage = Instance.new("ImageLabel")
    LogoImage.Size = UDim2.new(0, 26, 0, 26)
    LogoImage.Position = UDim2.new(0, 8, 0, 8)
    LogoImage.BackgroundTransparency = 1
    LogoImage.Image = LogoId
    LogoImage.Parent = Sidebar

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(1, -40, 0, 26)
    TitleLabel.Position = UDim2.new(0, 38, 0, 8)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = TitleText
    TitleLabel.TextColor3 = Theme.Text
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize = IsMobile and 11 or 12
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.Parent = Sidebar

    -- حاوية الأقسام
    local TabButtonContainer = Instance.new("ScrollingFrame")
    TabButtonContainer.Size = UDim2.new(1, -12, 1, -45)
    TabButtonContainer.Position = UDim2.new(0, 6, 0, 40)
    TabButtonContainer.BackgroundTransparency = 1
    TabButtonContainer.ScrollBarThickness = 0
    TabButtonContainer.Parent = Sidebar

    local TabListLayout = Instance.new("UIListLayout")
    TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabListLayout.Padding = UDim.new(0, 5)
    TabListLayout.Parent = TabButtonContainer

    -- منطقة المحتوى
    local ContentArea = Instance.new("Frame")
    ContentArea.Size = UDim2.new(1, IsMobile and -148 or -178, 1, -42)
    ContentArea.Position = UDim2.new(0, IsMobile and 142 or 172, 0, 36)
    ContentArea.BackgroundTransparency = 1
    ContentArea.Parent = MainFrame

    -- 🔔 نظام إشعارات فخم (Notifications)
    function MAX_UI:Notify(Title, Text, Duration)
        Duration = Duration or 3
        local NotifyFrame = Instance.new("Frame")
        NotifyFrame.Size = UDim2.new(0, 220, 0, 50)
        NotifyFrame.Position = UDim2.new(1, 10, 1, -65)
        NotifyFrame.BackgroundColor3 = Theme.Background
        NotifyFrame.Parent = ScreenGui

        local NCorner = Instance.new("UICorner")
        NCorner.CornerRadius = UDim.new(0, 8)
        NCorner.Parent = NotifyFrame

        local NStroke = Instance.new("UIStroke")
        NStroke.Color = Theme.Accent
        NStroke.Thickness = 1
        NStroke.Parent = NotifyFrame

        local NTitle = Instance.new("TextLabel")
        NTitle.Size = UDim2.new(1, -12, 0, 20)
        NTitle.Position = UDim2.new(0, 8, 0, 4)
        NTitle.BackgroundTransparency = 1
        NTitle.Text = Title
        NTitle.TextColor3 = Theme.Accent
        NTitle.Font = Enum.Font.GothamBold
        NTitle.TextSize = 11
        NTitle.TextXAlignment = Enum.TextXAlignment.Left
        NTitle.Parent = NotifyFrame

        local NText = Instance.new("TextLabel")
        NText.Size = UDim2.new(1, -12, 0, 20)
        NText.Position = UDim2.new(0, 8, 0, 24)
        NText.BackgroundTransparency = 1
        NText.Text = Text
        NText.TextColor3 = Theme.Text
        NText.Font = Enum.Font.GothamMedium
        NText.TextSize = 10
        NText.TextXAlignment = Enum.TextXAlignment.Left
        NText.Parent = NotifyFrame

        TweenService:Create(NotifyFrame, TweenInfo.new(0.3), {Position = UDim2.new(1, -230, 1, -65)}):Play()
        task.delay(Duration, function()
            TweenService:Create(NotifyFrame, TweenInfo.new(0.3), {Position = UDim2.new(1, 10, 1, -65)}):Play()
            task.wait(0.3)
            NotifyFrame:Destroy()
        end)
    end

    local WindowObj = {
        Tabs = {},
        Accents = {}
    }

    function WindowObj:CreateTab(TabName)
        local TabButton = Instance.new("TextButton")
        TabButton.Size = UDim2.new(1, 0, 0, 28)
        TabButton.BackgroundColor3 = Theme.ItemBg
        TabButton.Text = "  " .. TabName
        TabButton.TextColor3 = Theme.DarkText
        TabButton.Font = Enum.Font.GothamMedium
        TabButton.TextSize = IsMobile and 10 or 11
        TabButton.TextXAlignment = Enum.TextXAlignment.Left
        TabButton.AutoButtonColor = false
        TabButton.Parent = TabButtonContainer

        local BtnCorner = Instance.new("UICorner")
        BtnCorner.CornerRadius = UDim.new(0, 6)
        BtnCorner.Parent = TabButton

        local PageFrame = Instance.new("ScrollingFrame")
        PageFrame.Size = UDim2.new(1, 0, 1, 0)
        PageFrame.BackgroundTransparency = 1
        PageFrame.Visible = false
        PageFrame.ScrollBarThickness = 2
        PageFrame.ScrollBarImageColor3 = Theme.Accent
        PageFrame.Parent = ContentArea

        local PageListLayout = Instance.new("UIListLayout")
        PageListLayout.SortOrder = Enum.SortOrder.LayoutOrder
        PageListLayout.Padding = UDim.new(0, 6)
        PageListLayout.Parent = PageFrame

        TabButton.MouseButton1Click:Connect(function()
            for _, tab in ipairs(WindowObj.Tabs) do
                tab.Page.Visible = false
                tab.Button.TextColor3 = Theme.DarkText
                tab.Button.BackgroundColor3 = Theme.ItemBg
            end
            PageFrame.Visible = true
            TabButton.TextColor3 = Theme.Text
            TabButton.BackgroundColor3 = Theme.Accent
        end)

        local TabElements = { Page = PageFrame, Button = TabButton }

        function TabElements:AddButton(Text, Callback)
            Callback = Callback or function() end
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, -6, 0, 30)
            Btn.BackgroundColor3 = Theme.ItemBg
            Btn.Text = Text
            Btn.TextColor3 = Theme.Text
            Btn.Font = Enum.Font.GothamBold
            Btn.TextSize = 11
            Btn.Parent = PageFrame

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 6)
            Corner.Parent = Btn

            Btn.MouseButton1Click:Connect(function()
                TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.Accent}):Play()
                task.wait(0.1)
                TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.ItemBg}):Play()
                Callback()
            end)
        end

        function TabElements:AddToggle(Text, Default, Callback)
            Callback = Callback or function() end
            local Toggled = Default or false

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -6, 0, 30)
            Frame.BackgroundColor3 = Theme.ItemBg
            Frame.Parent = PageFrame

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 6)
            Corner.Parent = Frame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -40, 1, 0)
            Label.Position = UDim2.new(0, 8, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = Text
            Label.TextColor3 = Theme.Text
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 11
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame

            local Indicator = Instance.new("TextButton")
            Indicator.Size = UDim2.new(0, 18, 0, 18)
            Indicator.Position = UDim2.new(1, -24, 0.5, -9)
            Indicator.BackgroundColor3 = Toggled and Theme.Accent or Color3.fromRGB(40, 40, 50)
            Indicator.Text = ""
            Indicator.Parent = Frame

            table.insert(WindowObj.Accents, function(col)
                if Toggled then Indicator.BackgroundColor3 = col end
            end)

            local IndCorner = Instance.new("UICorner")
            IndCorner.CornerRadius = UDim.new(0, 4)
            IndCorner.Parent = Indicator

            local function UpdateToggle()
                Toggled = not Toggled
                Indicator.BackgroundColor3 = Toggled and Theme.Accent or Color3.fromRGB(40, 40, 50)
                Callback(Toggled)
            end

            Indicator.MouseButton1Click:Connect(UpdateToggle)
        end

        function TabElements:AddSlider(Text, Min, Max, Default, Callback)
            Callback = Callback or function() end
            local Value = Default or Min

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -6, 0, 40)
            Frame.BackgroundColor3 = Theme.ItemBg
            Frame.Parent = PageFrame

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 6)
            Corner.Parent = Frame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -50, 0, 18)
            Label.Position = UDim2.new(0, 8, 0, 2)
            Label.BackgroundTransparency = 1
            Label.Text = Text
            Label.TextColor3 = Theme.Text
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 11
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame

            local ValLabel = Instance.new("TextLabel")
            ValLabel.Size = UDim2.new(0, 40, 0, 18)
            ValLabel.Position = UDim2.new(1, -45, 0, 2)
            ValLabel.BackgroundTransparency = 1
            ValLabel.Text = tostring(Value)
            ValLabel.TextColor3 = Theme.Accent
            ValLabel.Font = Enum.Font.GothamBold
            ValLabel.TextSize = 11
            ValLabel.Parent = Frame

            table.insert(WindowObj.Accents, function(col)
                ValLabel.TextColor3 = col
            end)

            local SliderBar = Instance.new("Frame")
            SliderBar.Size = UDim2.new(1, -16, 0, 5)
            SliderBar.Position = UDim2.new(0, 8, 1, -10)
            SliderBar.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            SliderBar.Parent = Frame

            local SliderFill = Instance.new("Frame")
            SliderFill.Size = UDim2.new((Value - Min)/(Max - Min), 0, 1, 0)
            SliderFill.BackgroundColor3 = Theme.Accent
            SliderFill.BorderSizePixel = 0
            SliderFill.Parent = SliderBar

            table.insert(WindowObj.Accents, function(col)
                SliderFill.BackgroundColor3 = col
            end)

            local Dragging = false
            local function Update(input)
                local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
                Value = math.floor(Min + (Max - Min) * pos)
                ValLabel.Text = tostring(Value)
                SliderFill.Size = UDim2.new(pos, 0, 1, 0)
                Callback(Value)
            end

            SliderBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Dragging = true; Update(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Dragging = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    Update(input)
                end
            end)
        end

        table.insert(WindowObj.Tabs, TabElements)

        if #WindowObj.Tabs == 1 then
            PageFrame.Visible = true
            TabButton.TextColor3 = Theme.Text
            TabButton.BackgroundColor3 = Theme.Accent
        end

        return TabElements
    end

    -- ============================================================
    -- ⚙️ تبويب الإعدادات التلقائي (الألوان والحجم)
    -- ============================================================
    local SettingsTab = WindowObj:CreateTab("⚙️ الإعدادات")

    local function ApplyAccentColor(col)
        Theme.Accent = col
        MainStroke.Color = col
        PageFrame_ScrollBar = col
        for _, updateFunc in ipairs(WindowObj.Accents) do
            updateFunc(col)
        end
        MAX_UI:Notify("👑 MAX HUB", "تم تغيير اللون بنجاح!", 2)
    end

    SettingsTab:AddButton("🎨 أزرق نيون (Neon Blue)", function() ApplyAccentColor(Color3.fromRGB(0, 170, 255)) end)
    SettingsTab:AddButton("🎨 بنفسجي فخم (Luxury Purple)", function() ApplyAccentColor(Color3.fromRGB(140, 80, 255)) end)
    SettingsTab:AddButton("🎨 أحمر ناري (Flame Red)", function() ApplyAccentColor(Color3.fromRGB(255, 50, 50)) end)
    SettingsTab:AddButton("🎨 أخضر زمردي (Emerald Green)", function() ApplyAccentColor(Color3.fromRGB(0, 230, 120)) end)
    SettingsTab:AddButton("🎨 أصفر ذهبي (Golden Yellow)", function() ApplyAccentColor(Color3.fromRGB(255, 190, 0)) end)

    SettingsTab:AddButton("👁️ إخفاء / إظهار الواجهة", function()
        MainFrame.Visible = not MainFrame.Visible
    end)

    MAX_UI:Notify("👑 MAX HUB", "تم التعرف على الجهاز: " .. DeviceType, 4)

    return WindowObj
end

return MAX_UI
