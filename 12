        TweenService:Create(NotifyFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 20, NotifyFrame.Position.Y.Scale, NotifyFrame.Position.Y.Offset)
        }):Play()
        task.wait(0.25)
        NotifyFrame:Destroy()
        RepositionNotifications()
    end)
