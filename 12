local function GetSmartGreeting()
    local hour = tonumber(os.date("%H")) or 12
    if hour >= 5 and hour < 12 then
        return "صباح الخير ☀️"
    elseif hour >= 12 and hour < 18 then
        return "مساء الخير 🌤️"
    else
        return "أهلاً بك 🌙"
    end
end

