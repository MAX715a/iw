            Label.Parent = Frame

            local ValLabel = Instance.new("TextLabel")
            ValLabel.Size = UDim2.new(0, 40, 0, 18)
            ValLabel.Position = UDim2.new(1, -45, 0, 4)
            ValLabel.BackgroundTransparency = 1
            ValLabel.Text = tostring(Value)
            ValLabel.TextColor3 = Theme.Accent
            ValLabel.Font = Enum.Font.GothamBold
            ValLabel.TextSize = 11
            ValLabel.Parent = Frame

            table.insert(WindowObj.Accents, function(col) ValLabel.TextColor3 = col end)

            local SliderBar = Instance.new("Frame")
            SliderBar.Size = UDim2.new(1, -20, 0, 5)
            SliderBar.Position = UDim2.new(0, 10, 1, -10)
            SliderBar.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            SliderBar.Parent = Frame

            local SliderFill = Instance.new("Frame")
            SliderFill.Size = UDim2.new((Value - Min)/(Max - Min), 0, 1, 0)
            SliderFill.BackgroundColor3 = Theme.Accent
            SliderFill.BorderSizePixel = 0
            SliderFill.Parent = SliderBar

            table.insert(WindowObj.Accents, function(col) SliderFill.BackgroundColor3 = col end)

            local Dragging = false
            local lastUpdate = 0

            local function Update(input)
                local now = tick()
                if now - lastUpdate < 0.02 then return end
                lastUpdate = now

                local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
                Value = math.floor(Min + (Max - Min) * pos)
                ValLabel.Text = tostring(Value)
                SliderFill.Size = UDim2.new(pos, 0, 1, 0)
                Callback(Value)
            end

            SliderBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Dragging = true; Update(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Dragging = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    Update(input)
                end
            end)
        end

        -- 🎨 قائمة الألوان العمودية الممتدة بالعرض الكامل (بدون أي تقطيع للكلمات)
        function TabElements:AddColorPicker(Text, Callback)
            Callback = Callback or function() end

            local TitleLabel = Instance.new("TextLabel")
            TitleLabel.Size = UDim2.new(1, -6, 0, 22)
            TitleLabel.BackgroundTransparency = 1
            TitleLabel.Text = "🎨 " .. Text
            TitleLabel.TextColor3 = Theme.TextPrimary
            TitleLabel.Font = Enum.Font.GothamBold
            TitleLabel.TextSize = 12
            TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
            TitleLabel.Parent = PageFrame

            local ListContainer = Instance.new("Frame")
            ListContainer.Size = UDim2.new(1, -6, 0, #ColorPalette * 36)
            ListContainer.BackgroundTransparency = 1
            ListContainer.Parent = PageFrame

            local ListLayout = Instance.new("UIListLayout")
            ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
            ListLayout.Padding = UDim.new(0, 5)
            ListLayout.Parent = ListContainer

            for _, item in ipairs(ColorPalette) do
                local ColorBtn = Instance.new("TextButton")
                ColorBtn.Size = UDim2.new(1, 0, 0, 32)
                ColorBtn.BackgroundColor3 = Theme.ItemBg
                ColorBtn.Text = ""
                ColorBtn.AutoButtonColor = false
                ColorBtn.Parent = ListContainer

                local Corner = Instance.new("UICorner")
                Corner.CornerRadius = UDim.new(0, 6)
                Corner.Parent = ColorBtn

                local Box = Instance.new("Frame")
                Box.Size = UDim2.new(0, 18, 0, 18)
                Box.Position = UDim2.new(0, 10, 0.5, -9)
                Box.BackgroundColor3 = item.Color
                Box.Parent = ColorBtn

                local BoxCorner = Instance.new("UICorner")
                BoxCorner.CornerRadius = UDim.new(0, 4)
                BoxCorner.Parent = Box

                local BtnText = Instance.new("TextLabel")
                BtnText.Size = UDim2.new(1, -40, 1, 0)
                BtnText.Position = UDim2.new(0, 36, 0, 0)
                BtnText.BackgroundTransparency = 1
                BtnText.Text = item.Name
                BtnText.TextColor3 = Theme.TextPrimary
                BtnText.Font = Enum.Font.GothamMedium
                BtnText.TextSize = 11
                BtnText.TextXAlignment = Enum.TextXAlignment.Left
                BtnText.Parent = ColorBtn

                ColorBtn.MouseButton1Click:Connect(function()
                    Callback(item.Color)
                end)
            end
        end

        table.insert(WindowObj.Tabs, TabElements)

        if #WindowObj.Tabs == 1 then
            PageFrame.Visible = true
            TabIcon.ImageColor3 = Theme.TextPrimary
            TabTitle.TextColor3 = Theme.TextPrimary
            TabButton.BackgroundColor3 = Theme.Accent
        end

        return TabElements
    end

    -- ============================================================
    -- 🎨 تبويب الإعدادات المدمج
    -- ============================================================
    local SettingsTab = WindowObj:CreateTab("الإعدادات ⚙️")

    local function ApplyColor(col)
        Theme.Accent = col
        MainStroke.Color = col
        ReopenStroke.Color = col
        CardStroke.Color = col
        GreetingLabel.TextColor3 = col
        for _, updateFunc in ipairs(WindowObj.Accents) do updateFunc(col) end
    end

    SettingsTab:AddColorPicker("تحديد لون الثيم المفضل", function(selectedColor)
        ApplyColor(selectedColor)
    end)

    return WindowObj
end

return MAX_UI
