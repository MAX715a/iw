    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Padding = UDim.new(0, 8)
    Layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
end

function MAX_TITAN:Notify(title, msg, duration)
    duration = duration or 3.5
    if not NotifyHolder and self.ScreenGui then InitNotifyHolder(self.ScreenGui) end
    if not NotifyHolder then return end

    local Theme = MAX_TITAN.Themes[MAX_TITAN.ActiveTheme]

    local Toast = Instance.new("Frame")
    Toast.Name = "Toast"
    Toast.Parent = NotifyHolder
    Toast.BackgroundColor3 = Theme.Container
    Toast.BorderColor3 = Theme.Accent
    Toast.BorderSizePixel = 1
    Toast.Size = UDim2.new(1, 0, 0, 55)
    Toast.Transparency = 1

    local ToastCorner = Instance.new("UICorner")
    ToastCorner.CornerRadius = UDim.new(0, 8)
    ToastCorner.Parent = Toast

    local TitleLbl = Instance.new("TextLabel")
    TitleLbl.Parent = Toast
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Position = UDim2.new(0, 12, 0, 6)
    TitleLbl.Size = UDim2.new(1, -24, 0, 18)
    TitleLbl.Font = Enum.Font.FredokaOne
    TitleLbl.Text = "👑 " .. tostring(title)
    TitleLbl.TextColor3 = Theme.Accent
    TitleLbl.TextSize = 13
    TitleLbl.TextXAlignment = Enum.TextXAlignment.Left

    local MsgLbl = Instance.new("TextLabel")
    MsgLbl.Parent = Toast
    MsgLbl.BackgroundTransparency = 1
    MsgLbl.Position = UDim2.new(0, 12, 0, 24)
    MsgLbl.Size = UDim2.new(1, -24, 0, 24)
    MsgLbl.Font = Enum.Font.FredokaOne
    MsgLbl.Text = tostring(msg)
    MsgLbl.TextColor3 = Theme.Text
    MsgLbl.TextSize = 11
    MsgLbl.TextWrapped = true
    MsgLbl.TextXAlignment = Enum.TextXAlignment.Left

    -- تأثير ظهور ناعم
    TweenService:Create(Toast, TweenInfo.new(0.3), {Transparency = 0}):Play()

    task.delay(duration, function()
        local tw = TweenService:Create(Toast, TweenInfo.new(0.3), {Transparency = 1})
        tw:Play()
        tw.Completed:Connect(function() Toast:Destroy() end)
    end)
end

