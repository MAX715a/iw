-- 🖼️ دالة معالجة وتحويل جميع أنواع الصور والأيديهات الرقمية
local function FormatImageAsset(AssetInput)
    if not AssetInput then return "rbxassetid://0" end
    local str = tostring(AssetInput)
    if str:find("rbxassetid://") or str:find("http://") or str:find("https://") or str:find("rbxthumb://") then
        return str
    elseif tonumber(str) then
        return "rbxassetid://" .. str
    end
    return "rbxassetid://0"
end

