            Arrow.Position = UDim2.new(1, -25, 0, 0)
            Arrow.BackgroundTransparency = 1
            Arrow.Text = "▼"
            Arrow.TextColor3 = Theme.TextDark
            Arrow.Font = Enum.Font.GothamBold
            Arrow.TextSize = 10
            Arrow.Parent = Frame

            local Container = Instance.new("Frame")
            Container.Size = UDim2.new(1, -12, 0, #ColorPalette * 28)
            Container.Position = UDim2.new(0, 6, 0, 34)
            Container.BackgroundTransparency = 1
            Container.Parent = Frame

            local CLayout = Instance.new("UIListLayout")
            CLayout.Padding = UDim.new(0, 3)
            CLayout.Parent = Container

            for _, item in ipairs(ColorPalette) do
                local ItemBtn = Instance.new("TextButton")
                ItemBtn.Size = UDim2.new(1, 0, 0, 25)
                ItemBtn.BackgroundColor3 = Color3.fromRGB(26, 28, 36)
                ItemBtn.Text = "      " .. item.Name
                ItemBtn.TextColor3 = Theme.TextPrimary
                ItemBtn.Font = Enum.Font.GothamMedium
                ItemBtn.TextSize = 10
                ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
                ItemBtn.Parent = Container

                local ICorner = Instance.new("UICorner")
                ICorner.CornerRadius = UDim.new(0, 4)
                ICorner.Parent = ItemBtn

                local ColorBox = Instance.new("Frame")
                ColorBox.Size = UDim2.new(0, 14, 0, 14)
                ColorBox.Position = UDim2.new(0, 6, 0.5, -7)
                ColorBox.BackgroundColor3 = item.Color
                ColorBox.Parent = ItemBtn

                local BoxCorner = Instance.new("UICorner")
                BoxCorner.CornerRadius = UDim.new(0, 3)
                BoxCorner.Parent = ColorBox

                ItemBtn.MouseButton1Click:Connect(function()
                    Expanded = false
                    TweenService:Create(Frame, TweenInfo.new(0.2), {Size = UDim2.new(1, -6, 0, 32)}):Play()
                    Arrow.Text = "▼"
                    Callback(item.Color)
                end)
            end

            DropBtn.MouseButton1Click:Connect(function()
                Expanded = not Expanded
                local targetHeight = Expanded and (38 + #ColorPalette * 28) or 32
                TweenService:Create(Frame, TweenInfo.new(0.2), {Size = UDim2.new(1, -6, 0, targetHeight)}):Play()
                Arrow.Text = Expanded and "▲" or "▼"
            end)
        end

        table.insert(WindowObj.Tabs, TabElements)

        if #WindowObj.Tabs == 1 then
            PageFrame.Visible = true
            TabIcon.ImageColor3 = Theme.TextPrimary
            TabTitle.TextColor3 = Theme.TextPrimary
            TabButton.BackgroundColor3 = Theme.Accent
        end

        return TabElements
    end

    -- ============================================================
    -- 🎨 تبويب الإعدادات ومكتبة الألوان
    -- ============================================================
    local SettingsTab = WindowObj:CreateTab("الإعدادات ⚙️")

    local function ApplyColor(col)
        Theme.Accent = col
        MainStroke.Color = col
        ReopenStroke.Color = col
        for _, updateFunc in ipairs(WindowObj.Accents) do updateFunc(col) end
        MAX_UI:Notify("👑 MAX ENGINE", "تم تحديث الثيم بنجاح!", 2)
    end

    SettingsTab:AddColorDropdown("اختر لون الثيم الرئيسي", function(selectedColor)
        ApplyColor(selectedColor)
    end)

    -- إرسال إشعار الترحيب المباشر
    MAX_UI:Notify("أهلاً بك 👑", "مرحباً " .. LocalPlayer.DisplayName .. " في محرك MAX ULTRA", 4)

    return WindowObj
end

return MAX_UI
