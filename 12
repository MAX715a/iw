function MAX_TITAN:CreateWindow(cfg)
    cfg = cfg or {}
    local Title = cfg.Name or "MAX TITAN ENGINE V99"
    local ToggleKey = cfg.Keybind or Enum.KeyCode.RightControl
    local CurrentTheme = MAX_TITAN.Themes[MAX_TITAN.ActiveTheme]

    -- ScreenGui Protect
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "MAX_TITAN_V99"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    pcall(function() ScreenGui.Parent = CoreGui end)
    if not ScreenGui.Parent then ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
    MAX_TITAN.ScreenGui = ScreenGui

    -- Main Container
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = CurrentTheme.MainBg
    MainFrame.BorderColor3 = CurrentTheme.Border
    MainFrame.BorderSizePixel = 1
    MainFrame.Position = UDim2.new(0.5, -310, 0.5, -210)
    MainFrame.Size = UDim2.new(0, 620, 0, 420)
    MainFrame.ClipsDescendants = true

    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 10)
    MainCorner.Parent = MainFrame

    -- Header (TopBar)
    local TopBar = Instance.new("Frame")
    TopBar.Name = "TopBar"
    TopBar.Parent = MainFrame
    TopBar.BackgroundColor3 = CurrentTheme.Sidebar
    TopBar.Size = UDim2.new(1, 0, 0, 40)

    local TitleLbl = Instance.new("TextLabel")
    TitleLbl.Parent = TopBar
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Position = UDim2.new(0, 15, 0, 0)
    TitleLbl.Size = UDim2.new(0.7, 0, 1, 0)
    TitleLbl.Font = Enum.Font.FredokaOne
    TitleLbl.Text = "👑 " .. Title
    TitleLbl.TextColor3 = CurrentTheme.Accent
    TitleLbl.TextSize = 15
    TitleLbl.TextXAlignment = Enum.TextXAlignment.Left

    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Parent = TopBar
    CloseBtn.BackgroundColor3 = Color3.fromRGB(220, 38, 38)
    CloseBtn.Position = UDim2.new(1, -32, 0.15, 0)
    CloseBtn.Size = UDim2.new(0, 26, 0, 26)
    CloseBtn.Font = Enum.Font.FredokaOne
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    CloseBtn.TextSize = 13

    local CloseCorner = Instance.new("UICorner")
    CloseCorner.CornerRadius = UDim.new(0, 6)
    CloseCorner.Parent = CloseBtn

    CloseBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = false
    end)

    -- Draggable Engine
    local dragging, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
        end
    end)

    MAX_TITAN:RegisterConn(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))

    TopBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Sidebar
    local Sidebar = Instance.new("ScrollingFrame")
    Sidebar.Name = "Sidebar"
    Sidebar.Parent = MainFrame
    Sidebar.BackgroundColor3 = CurrentTheme.Sidebar
    Sidebar.Position = UDim2.new(0, 0, 0, 40)
    Sidebar.Size = UDim2.new(0, 160, 1, -40)
    Sidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
    Sidebar.ScrollBarThickness = 2
    Sidebar.BorderSizePixel = 0

    local SidebarLayout = Instance.new("UIListLayout")
    SidebarLayout.Parent = Sidebar
    SidebarLayout.Padding = UDim.new(0, 6)

    -- Content Frame
    local ContentContainer = Instance.new("Frame")
    ContentContainer.Name = "ContentContainer"
    ContentContainer.Parent = MainFrame
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.Position = UDim2.new(0, 165, 0, 45)
    ContentContainer.Size = UDim2.new(1, -170, 1, -50)

    local WindowObj = {
        Tabs = {},
        CurrentTab = nil
    }

    -- Tab Factory
    function WindowObj:CreateTab(tabName)
        local TabScroll = Instance.new("ScrollingFrame")
        TabScroll.Name = tabName .. "_Content"
        TabScroll.Parent = ContentContainer
        TabScroll.BackgroundTransparency = 1
        TabScroll.Size = UDim2.new(1, 0, 1, 0)
        TabScroll.Visible = false
        TabScroll.ScrollBarThickness = 4
        TabScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y

        local TabLayout = Instance.new("UIListLayout")
        TabLayout.Parent = TabScroll
        TabLayout.Padding = UDim.new(0, 8)

        local TabBtn = Instance.new("TextButton")
        TabBtn.Name = tabName .. "_Btn"
        TabBtn.Parent = Sidebar
        TabBtn.Size = UDim2.new(1, -10, 0, 36)
        TabBtn.BackgroundColor3 = CurrentTheme.Container
        TabBtn.Font = Enum.Font.FredokaOne
        TabBtn.Text = "  " .. tabName
        TabBtn.TextColor3 = CurrentTheme.SubText
        TabBtn.TextSize = 12
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left

        local BtnCorner = Instance.new("UICorner")
        BtnCorner.CornerRadius = UDim.new(0, 6)
        BtnCorner.Parent = TabBtn

        TabBtn.MouseButton1Click:Connect(function()
            for _, t in pairs(WindowObj.Tabs) do
                t.Scroll.Visible = false
                t.Btn.TextColor3 = CurrentTheme.SubText
                t.Btn.BackgroundColor3 = CurrentTheme.Container
            end
            TabScroll.Visible = true
            TabBtn.TextColor3 = CurrentTheme.Text
            TabBtn.BackgroundColor3 = CurrentTheme.Accent
        end)

        local Elements = {}

        -- Widget: Toggle
        function Elements:AddToggle(name, default, callback)
            MAX_TITAN.Flags[name] = default
            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -10, 0, 40)
            Frame.BackgroundColor3 = CurrentTheme.Container
            Frame.Parent = TabScroll

            local FCorner = Instance.new("UICorner")
            FCorner.CornerRadius = UDim.new(0, 6)
            FCorner.Parent = Frame

            local Lbl = Instance.new("TextLabel")
            Lbl.Parent = Frame
            Lbl.BackgroundTransparency = 1
            Lbl.Position = UDim2.new(0, 10, 0, 0)
            Lbl.Size = UDim2.new(0.65, 0, 1, 0)
            Lbl.Font = Enum.Font.FredokaOne
            Lbl.Text = name
            Lbl.TextColor3 = CurrentTheme.Text
            Lbl.TextSize = 12
            Lbl.TextXAlignment = Enum.TextXAlignment.Left

            local Btn = Instance.new("TextButton")
            Btn.Parent = Frame
            Btn.Position = UDim2.new(1, -75, 0.15, 0)
            Btn.Size = UDim2.new(0, 65, 0, 28)
            Btn.Font = Enum.Font.FredokaOne
            Btn.TextSize = 11

            local BCorner = Instance.new("UICorner")
            BCorner.CornerRadius = UDim.new(0, 6)
            BCorner.Parent = Btn

            local state = default
            local function update()
                MAX_TITAN.Flags[name] = state
                Btn.Text = state and "ON" or "OFF"
                Btn.BackgroundColor3 = state and CurrentTheme.Accent or Color3.fromRGB(30, 41, 59)
                Btn.TextColor3 = state and Color3.fromRGB(255, 255, 255) or CurrentTheme.SubText
            end
            update()

            Btn.MouseButton1Click:Connect(function()
                state = not state
                update()
                MAX_TITAN:SafeExecute(callback, state)
            end)
        end

        -- Widget: Slider
        function Elements:AddSlider(name, min, max, default, callback)
            MAX_TITAN.Flags[name] = default
            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -10, 0, 50)
            Frame.BackgroundColor3 = CurrentTheme.Container
            Frame.Parent = TabScroll

            local FCorner = Instance.new("UICorner")
            FCorner.CornerRadius = UDim.new(0, 6)
            FCorner.Parent = Frame

            local Lbl = Instance.new("TextLabel")
            Lbl.Parent = Frame
            Lbl.BackgroundTransparency = 1
            Lbl.Position = UDim2.new(0, 10, 0, 4)
            Lbl.Size = UDim2.new(0.8, 0, 0, 20)
            Lbl.Font = Enum.Font.FredokaOne
            Lbl.Text = name .. " : " .. tostring(default)
            Lbl.TextColor3 = CurrentTheme.Text
            Lbl.TextSize = 12
            Lbl.TextXAlignment = Enum.TextXAlignment.Left

            local Bar = Instance.new("TextButton")
            Bar.Parent = Frame
            Bar.Position = UDim2.new(0, 10, 0, 28)
            Bar.Size = UDim2.new(1, -20, 0, 12)
            Bar.BackgroundColor3 = Color3.fromRGB(30, 40, 60)
            Bar.Text = ""

            local Fill = Instance.new("Frame")
            Fill.Parent = Bar
            Fill.BackgroundColor3 = CurrentTheme.Accent
            Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
            Fill.BorderSizePixel = 0

            local function setVal(input)
                local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                local val = math.floor(min + (max - min) * pos)
                Fill.Size = UDim2.new(pos, 0, 1, 0)
                Lbl.Text = name .. " : " .. tostring(val)
                MAX_TITAN.Flags[name] = val
                MAX_TITAN:SafeExecute(callback, val)
            end

            local sliding = false
            Bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    setVal(input)
                end
            end)

            MAX_TITAN:RegisterConn(UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    setVal(input)
                end
            end))

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)
        end

        -- Widget: Button
        function Elements:AddButton(name, callback)
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, -10, 0, 38)
            Btn.BackgroundColor3 = CurrentTheme.Container
            Btn.Font = Enum.Font.FredokaOne
            Btn.Text = name
            Btn.TextColor3 = CurrentTheme.Text
            Btn.TextSize = 12
            Btn.Parent = TabScroll

            local BCorner = Instance.new("UICorner")
            BCorner.CornerRadius = UDim.new(0, 6)
            BCorner.Parent = Btn

            Btn.MouseButton1Click:Connect(function()
                MAX_TITAN:SafeExecute(callback)
            end)
        end

        -- Widget: Dropdown
        function Elements:AddDropdown(name, list, callback)
            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -10, 0, 40)
            Frame.BackgroundColor3 = CurrentTheme.Container
            Frame.Parent = TabScroll
            Frame.ClipsDescendants = true

            local FCorner = Instance.new("UICorner")
            FCorner.CornerRadius = UDim.new(0, 6)
            FCorner.Parent = Frame

            local DropBtn = Instance.new("TextButton")
            DropBtn.Size = UDim2.new(1, 0, 0, 40)
            DropBtn.BackgroundTransparency = 1
            DropBtn.Font = Enum.Font.FredokaOne
            DropBtn.Text = "  " .. name .. " ▼"
            DropBtn.TextColor3 = CurrentTheme.Text
            DropBtn.TextSize = 12
            DropBtn.TextXAlignment = Enum.TextXAlignment.Left
            DropBtn.Parent = Frame

            local Container = Instance.new("Frame")
            Container.Position = UDim2.new(0, 5, 0, 40)
            Container.Size = UDim2.new(1, -10, 0, #list * 28)
            Container.BackgroundTransparency = 1
            Container.Parent = Frame

            local Layout = Instance.new("UIListLayout")
            Layout.Parent = Container

            for _, item in ipairs(list) do
                local ItemBtn = Instance.new("TextButton")
                ItemBtn.Size = UDim2.new(1, 0, 0, 26)
                ItemBtn.BackgroundColor3 = Color3.fromRGB(25, 35, 55)
                ItemBtn.Font = Enum.Font.FredokaOne
                ItemBtn.Text = item
                ItemBtn.TextColor3 = CurrentTheme.SubText
                ItemBtn.TextSize = 11
                ItemBtn.Parent = Container

                ItemBtn.MouseButton1Click:Connect(function()
                    DropBtn.Text = "  " .. name .. " : " .. item .. " ▼"
                    Frame.Size = UDim2.new(1, -10, 0, 40)
                    MAX_TITAN.Flags[name] = item
                    MAX_TITAN:SafeExecute(callback, item)
                end)
            end

            local open = false
            DropBtn.MouseButton1Click:Connect(function()
                open = not open
                Frame.Size = open and UDim2.new(1, -10, 0, 45 + (#list * 28)) or UDim2.new(1, -10, 0, 40)
            end)
        end

        -- Widget: Label
        function Elements:AddLabel(text)
            local Lbl = Instance.new("TextLabel")
            Lbl.Size = UDim2.new(1, -10, 0, 25)
            Lbl.BackgroundTransparency = 1
            Lbl.Font = Enum.Font.FredokaOne
            Lbl.Text = text
            Lbl.TextColor3 = CurrentTheme.Accent
            Lbl.TextSize = 12
            Lbl.Parent = TabScroll
        end

        WindowObj.Tabs[tabName] = { Scroll = TabScroll, Btn = TabBtn }

        if not WindowObj.CurrentTab then
            WindowObj.CurrentTab = TabScroll
            TabScroll.Visible = true
            TabBtn.TextColor3 = CurrentTheme.Text
            TabBtn.BackgroundColor3 = CurrentTheme.Accent
        end

        return Elements
    end

    -- Keybind Toggle UI
    MAX_TITAN:RegisterConn(UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == ToggleKey then
            MainFrame.Visible = not MainFrame.Visible
        end
    end))

    return WindowObj
end

