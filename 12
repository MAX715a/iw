    table.insert(ActiveNotifications, NotifyFrame)
    local function RepositionNotifications()
        for index, frame in ipairs(ActiveNotifications) do
            local targetY = -100 - ((#ActiveNotifications - index) * 78)
            TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = UDim2.new(1, -325, 1, targetY)
            }):Play()
        end
    end

    RepositionNotifications()
    TweenService:Create(TimeBar, TweenInfo.new(Duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 3)}):Play()

