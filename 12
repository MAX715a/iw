            SliderFill.Parent = SliderTrack

            local FillCorner = Instance.new("UICorner")
            FillCorner.CornerRadius = UDim.new(1, 0)
            FillCorner.Parent = SliderFill

            -- 🔘 دائرة السحب الكبيرة الملموسة
            local DragKnob = Instance.new("Frame")
            DragKnob.Size = UDim2.new(0, 18, 0, 18)
            DragKnob.Position = UDim2.new(1, -9, 0.5, -9)
            DragKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            DragKnob.Parent = SliderFill

            local KnobCorner = Instance.new("UICorner")
            KnobCorner.CornerRadius = UDim.new(1, 0)
            KnobCorner.Parent = DragKnob

            local KnobStroke = Instance.new("UIStroke")
            KnobStroke.Color = Theme.Accent
            KnobStroke.Thickness = 2
            KnobStroke.Parent = DragKnob

            local Dragging = false
            local lastUpdate = 0

            local function Update(input)
                local now = tick()
                if now - lastUpdate < 0.02 then return end
                lastUpdate = now

                local pos = math.clamp((input.Position.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
                Value = math.floor(Min + (Max - Min) * pos)
                ValLabel.Text = "المحدد: " .. tostring(Value)
                SliderFill.Size = UDim2.new(pos, 0, 1, 0)
                Callback(Value)
            end

            SliderTrack.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Dragging = true; Update(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Dragging = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    Update(input)
                end
            end)
        end

        -- 🔘 4. صندوق النصوص
        function TabElements:AddTextbox(Text, Placeholder, Callback)
            Callback = Callback or function() end

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -6, 0, 36)
            Frame.BackgroundColor3 = Theme.ItemBg
            Frame.Parent = PageFrame

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 6)
            Corner.Parent = Frame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.5, 0, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = Text
            Label.TextColor3 = Theme.TextPrimary
            Label.Font = Enum.Font.GothamBlack
            Label.TextSize = 11
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame

            local InputBox = Instance.new("TextBox")
            InputBox.Size = UDim2.new(0.45, 0, 0.7, 0)
            InputBox.Position = UDim2.new(0.52, 0, 0.15, 0)
            InputBox.BackgroundColor3 = Color3.fromRGB(25, 27, 38)
            InputBox.Text = ""
            InputBox.PlaceholderText = Placeholder or "اكتب هنا..."
            InputBox.TextColor3 = Theme.Accent
            InputBox.PlaceholderColor3 = Theme.TextDark
            InputBox.Font = Enum.Font.GothamBlack
            InputBox.TextSize = 10
            InputBox.Parent = Frame

            local BoxCorner = Instance.new("UICorner")
            BoxCorner.CornerRadius = UDim.new(0, 5)
            BoxCorner.Parent = InputBox

            InputBox.FocusLost:Connect(function(enterPressed)
                if enterPressed then
                    Callback(InputBox.Text)
                    NotifySystem(TitleText, "تم إدخال: " .. InputBox.Text, 2.5)
                end
            end)
        end

        -- 🔘 5. القوائم المنسدلة
        function TabElements:AddDropdown(Text, ListOptions, Callback)
            Callback = Callback or function() end
            ListOptions = ListOptions or {}
            local Expanded = false

            local DropdownMain = Instance.new("Frame")
            DropdownMain.Size = UDim2.new(1, -6, 0, 36)
            DropdownMain.BackgroundColor3 = Theme.ItemBg
            DropdownMain.ClipsDescendants = true
            DropdownMain.Parent = PageFrame

            local DropCorner = Instance.new("UICorner")
            DropCorner.CornerRadius = UDim.new(0, 6)
            DropCorner.Parent = DropdownMain

            local HeaderBtn = Instance.new("TextButton")
            HeaderBtn.Size = UDim2.new(1, 0, 0, 36)
            HeaderBtn.BackgroundTransparency = 1
            HeaderBtn.Text = ""
            HeaderBtn.Parent = DropdownMain

            local Title = Instance.new("TextLabel")
            Title.Size = UDim2.new(1, -40, 1, 0)
            Title.Position = UDim2.new(0, 10, 0, 0)
            Title.BackgroundTransparency = 1
            Title.Text = Text
            Title.TextColor3 = Theme.TextPrimary
            Title.Font = Enum.Font.GothamBlack
            Title.TextSize = 11
            Title.TextXAlignment = Enum.TextXAlignment.Left
            Title.Parent = HeaderBtn

            local Arrow = Instance.new("TextLabel")
            Arrow.Size = UDim2.new(0, 24, 0, 24)
            Arrow.Position = UDim2.new(1, -30, 0.5, -12)
            Arrow.BackgroundTransparency = 1
            Arrow.Text = "▼"
            Arrow.TextColor3 = Theme.Accent
            Arrow.Font = Enum.Font.GothamBlack
            Arrow.TextSize = 10
            Arrow.Parent = HeaderBtn

            local ItemsHolder = Instance.new("Frame")
            ItemsHolder.Size = UDim2.new(1, -12, 0, #ListOptions * 28)
            ItemsHolder.Position = UDim2.new(0, 6, 0, 38)
            ItemsHolder.BackgroundTransparency = 1
            ItemsHolder.Parent = DropdownMain

            local ListLayout = Instance.new("UIListLayout")
            ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
            ListLayout.Padding = UDim.new(0, 4)
            ListLayout.Parent = ItemsHolder

            for _, opt in ipairs(ListOptions) do
                local ItemBtn = Instance.new("TextButton")
                ItemBtn.Size = UDim2.new(1, 0, 0, 24)
                ItemBtn.BackgroundColor3 = Color3.fromRGB(25, 27, 38)
                ItemBtn.Text = opt
                ItemBtn.TextColor3 = Theme.TextPrimary
                ItemBtn.Font = Enum.Font.GothamBlack
                ItemBtn.TextSize = 10
                ItemBtn.Parent = ItemsHolder

                local ItemCorner = Instance.new("UICorner")
                ItemCorner.CornerRadius = UDim.new(0, 4)
                ItemCorner.Parent = ItemBtn

                ItemBtn.MouseButton1Click:Connect(function()
                    Expanded = false
                    Arrow.Text = "▼"
                    TweenService:Create(DropdownMain, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Size = UDim2.new(1, -6, 0, 36)}):Play()
                    Callback(opt)
                    NotifySystem(TitleText, "تم تحديد: " .. opt, 2.5)
                end)
            end

            HeaderBtn.MouseButton1Click:Connect(function()
                Expanded = not Expanded
                Arrow.Text = Expanded and "▲" or "▼"
                local TargetHeight = Expanded and (42 + #ListOptions * 28) or 36
                TweenService:Create(DropdownMain, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Size = UDim2.new(1, -6, 0, TargetHeight)}):Play()
            end)
        end

        -- 🔘 6. الكروت النصية
        function TabElements:AddLabel(Text)
            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -6, 0, 30)
            Frame.BackgroundColor3 = Theme.ItemBg
            Frame.Parent = PageFrame

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 6)
            Corner.Parent = Frame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -12, 1, 0)
            Label.Position = UDim2.new(0, 6, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = Text
            Label.TextColor3 = Theme.Accent
            Label.Font = Enum.Font.GothamBlack
            Label.TextSize = 10
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame
        end

        table.insert(WindowObj.Tabs, TabElements)

        if #WindowObj.Tabs == 1 then
            PageFrame.Visible = true
            TabTitle.TextColor3 = Theme.TextPrimary
            TabButton.BackgroundColor3 = Theme.Accent
        end

        return TabElements
    end

    -- ============================================================
    -- ⚙️ قسم الإعدادات وأدوات تسريع اللعبة
    -- ============================================================
    local SettingsTab = WindowObj:CreateTab("الإعدادات", PlayerAvatarImage)

    SettingsTab:AddLabel("👑 MAX TITAN ENGINE - أدوات تسريع الفريمات والذاكرة")

    SettingsTab:AddButton("تنظيف الذاكرة العشوائية (RAM Cleaner) 🧹", function()
        pcall(function()
            collectgarbage("collect")
        end)
    end)

    SettingsTab:AddButton("تسريع الفريمات (Ultra FPS Boost) ⚡", function()
        pcall(function()
            for _, obj in ipairs(game:GetDescendants()) do
                if obj:IsA("BasePart") then
                    obj.Material = Enum.Material.SmoothPlastic
                elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                    obj.Enabled = false
                elseif obj:IsA("PostEffect") or obj:IsA("BloomEffect") or obj:IsA("SunRaysEffect") or obj:IsA("BlurEffect") then
                    obj.Enabled = false
                end
            end
            Lighting.GlobalShadows = false
            Lighting.Technology = Enum.Technology.Compatibility
        end)
    end)

    SettingsTab:AddButton("إزالة الضباب والظلال (Clear Fog) 🌫️", function()
        pcall(function()
            Lighting.FogEnd = 9e9
            Lighting.GlobalShadows = false
        end)
    end)

    -- إشعار الترحيب المباشر مع سكنك
    NotifySystem(GetSmartGreeting(), "مرحباً بك يا " .. LocalPlayer.DisplayName .. " في " .. TitleText, 3.5)

    return WindowObj
end

return MAX_UI
