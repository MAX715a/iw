            Box.Parent = Frame
            Box.Position = UDim2.new(1, -145, 0.18, 0)
            Box.Size = UDim2.new(0, 135, 0, 26)
            Box.BackgroundColor3 = Color3.fromRGB(22, 32, 54)
            Box.Font = Enum.Font.FredokaOne
            Box.PlaceholderText = placeholder or "اكتب هنا..."
            Box.Text = ""
            Box.TextColor3 = Theme.Text
            Box.TextSize = 11

            local BCorner = Instance.new("UICorner")
            BCorner.CornerRadius = UDim.new(0, 6)
            BCorner.Parent = Box

            Box.FocusLost:Connect(function(enterPressed)
                MAX_TITAN.Flags[name] = Box.Text
                MAX_TITAN:SafeExecute(callback, Box.Text, enterPressed)
            end)
        end

        -- 6. Widget: Label (فاصل/عنوان)
        function Elements:AddLabel(text)
            local Lbl = Instance.new("TextLabel")
            Lbl.Size = UDim2.new(1, -10, 0, 25)
            Lbl.BackgroundTransparency = 1
            Lbl.Font = Enum.Font.FredokaOne
            Lbl.Text = text
            Lbl.TextColor3 = Theme.Accent
            Lbl.TextSize = 12
            Lbl.Parent = TabScroll
        end

        WindowObj.Tabs[tabName] = { Scroll = TabScroll, Btn = TabBtn }

        if not WindowObj.CurrentTab then
            WindowObj.CurrentTab = TabScroll
            TabScroll.Visible = true
            TabBtn.TextColor3 = Theme.Text
            TabBtn.BackgroundColor3 = Theme.Accent
        end

        return Elements
    end

    -- 📌 إتاحة إضافة خيارات قسم الإعدادات المثبت سفلياً
    local SettingsElements = {}

    function SettingsElements:AddSlider(name, min, max, default, callback)
        local Frame = Instance.new("Frame")
        Frame.Size = UDim2.new(1, -10, 0, 50)
        Frame.BackgroundColor3 = Theme.Container
        Frame.Parent = SettingsScroll

        local FCorner = Instance.new("UICorner")
        FCorner.CornerRadius = UDim.new(0, 6)
        FCorner.Parent = Frame

        local Lbl = Instance.new("TextLabel")
        Lbl.Parent = Frame
        Lbl.BackgroundTransparency = 1
        Lbl.Position = UDim2.new(0, 12, 0, 4)
        Lbl.Size = UDim2.new(0.8, 0, 0, 20)
        Lbl.Font = Enum.Font.FredokaOne
        Lbl.Text = name .. " : " .. tostring(default)
        Lbl.TextColor3 = Theme.Text
        Lbl.TextSize = 12
        Lbl.TextXAlignment = Enum.TextXAlignment.Left

        local Bar = Instance.new("TextButton")
        Bar.Parent = Frame
        Bar.Position = UDim2.new(0, 12, 0, 28)
        Bar.Size = UDim2.new(1, -24, 0, 10)
        Bar.BackgroundColor3 = Color3.fromRGB(25, 35, 55)
        Bar.Text = ""

        local Fill = Instance.new("Frame")
        Fill.Parent = Bar
        Fill.BackgroundColor3 = Theme.Accent
        Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
        Fill.BorderSizePixel = 0

        local function setVal(input)
            local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + (max - min) * pos)
            Fill.Size = UDim2.new(pos, 0, 1, 0)
            Lbl.Text = name .. " : " .. tostring(val)
            MAX_TITAN.Flags[name] = val
            MAX_TITAN:SafeExecute(callback, val)
        end

        local sliding = false
        Bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                setVal(input)
            end
        end)

        MAX_TITAN:RegisterConn(UserInputService.InputChanged:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                setVal(input)
            end
        end))

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = false
            end
        end)
    end

    function SettingsElements:AddButton(name, callback)
        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(1, -10, 0, 38)
        Btn.BackgroundColor3 = Theme.Container
        Btn.Font = Enum.Font.FredokaOne
        Btn.Text = name
        Btn.TextColor3 = Theme.Text
        Btn.TextSize = 12
        Btn.Parent = SettingsScroll

        local BCorner = Instance.new("UICorner")
        BCorner.CornerRadius = UDim.new(0, 6)
        BCorner.Parent = Btn

        Btn.MouseButton1Click:Connect(function()
            MAX_TITAN:SafeExecute(callback)
        end)
    end

    function SettingsElements:AddLabel(text)
        local Lbl = Instance.new("TextLabel")
        Lbl.Size = UDim2.new(1, -10, 0, 25)
        Lbl.BackgroundTransparency = 1
        Lbl.Font = Enum.Font.FredokaOne
        Lbl.Text = text
        Lbl.TextColor3 = Theme.Accent
        Lbl.TextSize = 12
        Lbl.Parent = SettingsScroll
    end

    WindowObj.Settings = SettingsElements

    -- Keybind Toggle
    MAX_TITAN:RegisterConn(UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == ToggleKey then
            MainFrame.Visible = not MainFrame.Visible
        end
    end))

    return WindowObj
end

