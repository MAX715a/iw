-- ============================================================

function MAX_TITAN:RegisterConn(conn)
    table.insert(self.Connections, conn)
    return conn
end

function MAX_TITAN:SpawnThread(fn)
    local thread = task.spawn(function()
        local ok, err = pcall(fn)
        if not ok and self.DebugMode then
            warn("[MAX TITAN EXCEPTION]: " .. tostring(err))
        end
    end)
    table.insert(self.Threads, thread)
    return thread
end

function MAX_TITAN:SafeExecute(fn, ...)
    local args = {...}
    return pcall(function() return fn(unpack(args)) end)
end

function MAX_TITAN:Unload()
    for _, conn in ipairs(self.Connections) do
        if conn and conn.Connected then conn:Disconnect() end
    end
    for _, thread in ipairs(self.Threads) do
        if thread then task.cancel(thread) end
    end
    table.clear(self.Connections)
    table.clear(self.Threads)
    if self.ScreenGui then self.ScreenGui:Destroy() end
    print("[MAX TITAN ENGINE]: Cleanly Unloaded.")
end

